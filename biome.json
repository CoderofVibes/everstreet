{
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!**/node_modules",
      "!.near-credentials",
      "!.evm-credentials",
      "!**/target",
      "!web/dist",
      "!web/dist-proof",
      "!.claude",
      "!docs",
      "!design",
      "!data",
      "!package-lock.json",
      "!server/test/fixtures/v3/direct-sale.json",
      "!server/test/fixtures/v3/gated-sale.json",
      "!web/src/showcase/samples.json",
      "!web/src/showcase/relaydesk.json",
      "!web/src/showcase/signalwatch.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
