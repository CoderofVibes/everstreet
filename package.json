{
  "name": "everstreet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app": "vite build --config web/vite.config.ts && tsx server/src/main.ts",
    "serve": "tsx server/src/main.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "openseat": "tsx services/openseat/src/main.ts",
    "handoff": "tsx scripts/handoff.ts",
    "inspect": "tsx scripts/inspect.ts",
    "probe:signer": "tsx scripts/probe-signer.ts",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup:v2": "tsx scripts/setup-v2.ts",
    "smoke:payments": "tsx scripts/smoke-payments.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "near-api-js": "7.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
