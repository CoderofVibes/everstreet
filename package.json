{
  "name": "everstreet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "openseat": "tsx services/openseat/src/main.ts",
    "handoff": "tsx scripts/handoff.ts",
    "inspect": "tsx scripts/inspect.ts",
    "probe:signer": "tsx scripts/probe-signer.ts",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "near-api-js": "7.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
